[Unit]
Description=OpenCanary Log Viewer - Real-time Web Interface
After=network.target
Documentation=https://github.com/omysurya/opencanary-viewer.git

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/opencanary-viewer
ExecStart=/opt/opencanary-viewer/opencanary-viewer
Restart=on-failure
RestartSec=5s

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/tmp

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opencanary-viewer

[Install]
WantedBy=multi-user.target
